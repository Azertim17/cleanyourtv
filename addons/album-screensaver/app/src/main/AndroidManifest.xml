<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Downloads the shared album (INTERNET) from the Immich server or Google Photos you give it, and nothing else. -->
    <!-- Both of the next two only used when the weather option is on (SettingsActivity asks for the location then):
         the TV's rough location, sent rounded to about 1 km to Open-Meteo. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to change the screen-off timeout (the idle time before the screensaver) when you pick one in the settings.
         Granted over adb by setup.sh; the TV has no screen where a person could grant it. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <!-- `settings put secure screensaver_components com.cleanyourtv.albumdream/.PhotoDream` (setup.sh does it). -->
        <service
            android:name=".PhotoDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>

        <!-- The slideshow at once, from the settings app's Preview button; Back leaves. -->
        <activity
            android:name=".SlideshowActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- The app: its card on cleanyourtv's Home (docs/modules.md), its tile in the app list, and the entry in the
             TV's screensaver settings (xml/dream.xml, which needs it exported) all open this. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Started by setup.sh: stores the album link and syncs it. Only the adb shell may start it. -->
        <activity
            android:name=".AlbumActivity"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- setup.sh with the off option clears the pictures through this (the app downloads them itself): on TCL G10 a file the shell copies into Android/data
             belongs to the shell and the app gets EACCES reading it. WRITE_SECURE_SETTINGS: the adb shell has
             it, ordinary apps don't. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="com.cleanyourtv.albumdream.files"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
